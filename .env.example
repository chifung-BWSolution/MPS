# =============================================================================
# MPS — Marketing Project System  (.env template)
# Supabase project: https://kwcevjcmdjadhrygjyfp.supabase.co
# =============================================================================
#
# HOW TO USE
# ----------
# A) Local Vite
#    1. Copy this file to `.env.local`  (gitignored)
#    2. Replace placeholders with keys from:
#       Supabase → MPS project → Settings → API
#    3. Restart `npm run dev`
#
# B) Cursor Cloud Agents → Secrets
#    Add the "Cloud Agent secrets" block below as separate secrets.
#    Prefer MPS_* names so Furniture / PMS shared VITE_* are not overwritten.
#
# Do NOT paste Furniture / PMS / Master URLs or keys here.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) Cloud Agent secrets (recommended — paste each as its own Cursor secret)
# -----------------------------------------------------------------------------
MPS_URL=https://kwcevjcmdjadhrygjyfp.supabase.co
MPS_ANON=PASTE_MPS_ANON_PUBLIC_KEY_HERE
MPS_SERVICE=PASTE_MPS_SERVICE_ROLE_KEY_HERE

# Optional — Supabase Management API (personal access token), multi-project admin only
# SUPABASE_ACCESS_TOKEN=PASTE_SUPABASE_PERSONAL_ACCESS_TOKEN_HERE


# -----------------------------------------------------------------------------
# 2) Local Vite / deploy (.env.local or Vercel env)
#    Same anon key as MPS_ANON. Required for the browser client.
#    If you use MPS_* above, `npm run env:mps` / predev will sync these for you.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://kwcevjcmdjadhrygjyfp.supabase.co
VITE_SUPABASE_ANON_KEY=PASTE_MPS_ANON_PUBLIC_KEY_HERE


# -----------------------------------------------------------------------------
# 3) DO NOT USE in this repo (other apps only)
# -----------------------------------------------------------------------------
# VITE_SUPABASE_URL=https://riaubhtruisbwdlwjzur.supabase.co   # Furniture
# MASTER_SUPABASE_URL=https://kqwktnplkqucsbasyfjl.supabase.co # PMS v3
# NEXT_PUBLIC_SUPABASE_URL=...
# BWF_SUPABASE_URL=...
